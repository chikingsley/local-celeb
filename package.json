{
	"name": "local-celeb",
	"private": true,
	"version": "0.3.0",
	"type": "module",
	"scripts": {
		"dev": "concurrently -n client,server -c blue,green \"bun run dev:client\" \"bun run dev:server\"",
		"dev:client": "vite",
		"dev:server": "bun run --hot server/src/index.ts",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"check": "bun run typecheck && bun run lint"
	},
	"dependencies": {
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.23.0",
		"radix-ui": "^1.6.1",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-hotkeys-hook": "^5.3.3",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3",
		"zustand": "^5.0.14"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.2",
		"@tailwindcss/vite": "^4.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^26.1.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"concurrently": "^10.0.3",
		"tailwindcss": "^4.3.2",
		"typescript": "^6.0.3",
		"vite": "^8.1.3"
	},
	"optionalDependencies": {
		"@elysiajs/cors": "^1.4.2",
		"elysia": "^1.4.29",
		"groq-sdk": "^1.3.0"
	}
}
